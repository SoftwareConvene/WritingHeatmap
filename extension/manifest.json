{
  "manifest_version": 3,
  "name": "Writing Heatmap by ClassConvene",
  "short_name": "Writing Heatmap",
  "version": "0.2.9",
  "description": "See how a Google Doc was written, passage by passage, without replaying the whole history. Runs entirely in your browser.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://docs.google.com/document/*",
    "https://docs.google.com/presentation/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Writing Heatmap: analyze this document, or open the class dashboard",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*",
        "https://docs.google.com/presentation/*"
      ],
      "js": [
        "content/docs.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
